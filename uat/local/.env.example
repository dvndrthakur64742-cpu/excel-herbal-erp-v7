# COPY to .env, NEVER COMMIT .env. Use only synthetic accounts.
# Exact reviewed Git commit: git rev-parse HEAD
EH7_LOCAL_SOURCE_SHA=REPLACE_WITH_EXACT_40_CHARACTER_GIT_SHA
# Replace all placeholder values with DIFFERENT random passwords.
EH7_LOCAL_DB_ROOT_PASSWORD=CHANGE_ME_RANDOM_ROOT_PASSWORD
EH7_LOCAL_DB_PASSWORD=CHANGE_ME_RANDOM_DB_PASSWORD
EH7_LOCAL_ADMIN_PASSWORD=CHANGE_ME_RANDOM_TEST_ADMIN_PASSWORD
EH7_LOCAL_LIMITED_PASSWORD=CHANGE_ME_RANDOM_TEST_EMPLOYEE_PASSWORD
